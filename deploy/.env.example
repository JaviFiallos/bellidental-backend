# Copiar a /opt/bellidental/.env, chmod 600; ver docs/DEPLOY-SETUP.md §5.

# Dominio base: app.<DOMAIN> y bot.<DOMAIN>
DOMAIN=
# Correo para los certificados de Let's Encrypt
ACME_EMAIL=
# Contraseña de la base de datos PostgreSQL
POSTGRES_PASSWORD=
# Clave de firma de los JWT del backend
JWT_SECRET=
# Clave que el agente usa para llamar al backend (/api/v1/bot/**)
BOT_API_KEY=

# Token de verificación del webhook de WhatsApp
WA_VERIFY_TOKEN=
# Secreto de la app de Meta para validar la firma de los webhooks
WA_APP_SECRET=
# Token de acceso de la API de WhatsApp Cloud
WA_ACCESS_TOKEN=
# Identificador del número de teléfono de WhatsApp Business
WA_PHONE_NUMBER_ID=
# Versión de la Graph API de Meta (ej. v21.0)
WA_GRAPH_VERSION=v23.0
# Recordatorios por WhatsApp: true solo cuando los WA_* y la plantilla de Meta estén listos
REMINDERS_ENABLED=false

# URL base del proveedor LLM compatible con OpenAI
LLM_BASE_URL=
# Clave del proveedor LLM
LLM_API_KEY=
# Nombre del modelo LLM
LLM_MODEL=

# Etiqueta de la imagen del backend (latest o sha-<commit>)
BACKEND_TAG=latest
# Etiqueta de la imagen del frontend
FRONTEND_TAG=latest
# Etiqueta de la imagen del agente
AGENT_TAG=latest
